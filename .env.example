# Server
NODE_ENV=development
API_PORT=4000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:8443,http://localhost:5173

# Database — Local MySQL (development)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=seruni_user
# DB_PASSWORD=change-this-password
# DB_NAME=seruni_db
# DB_SSL=false
# DB_CONNECTION_LIMIT=10

# Database — TiDB Cloud Starter (production)
# Dapatkan credentials dari dashboard TiDB Cloud → Connect
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=prefix.root
DB_PASSWORD=your-tidb-cloud-password
DB_NAME=seruni_db
DB_SSL=true
DB_CONNECTION_LIMIT=5

# Used only when the database is initialized for the first time.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-admin-password
MYSQLDUMP_PATH=mysqldump
